# .claude/harness.env の見本（Laravel + Inertia + Vue、PostgreSQL、PHPUnit）
#
# 実際の PJ で使っていたものから、PJ だけの事情（worktree の作り方、DB のユーザー名など）を抜いた形。
# そのまま使わず、templates/harness.env の説明を読んで、自分の PJ に合わせて直す。

# ---- 受け入れテスト ----
ACCEPT_DEST_ROOT="tests/Acceptance"
ACCEPT_GLOB="*Test.php"
# namespace Tests\Acceptance\<Studly> と PSR-4（Tests\ → tests/）を合わせるため、ディレクトリ名を Studly にする
ACCEPT_DIR_NAME="studly"

accept_run() {
  php artisan test "$1" --compact
}

# ---- 検査 ----
CHECK_BASE="origin/main"

# ---- 準備 ----
harness_env() {
  # worktree ごとに DB やポートを分けているなら、その設定ファイルをここで読む。
  # pre-push フックのように、その設定を読んでいないシェルから呼ばれても、同じ DB に向くようにするため
  #   例: if [ -f worktree.env ]; then set -a; . ./worktree.env; set +a; fi
  export DB_HOST="${DB_HOST:-127.0.0.1}"
  export DB_PORT="${DB_PORT:-5432}"
  # PHPUnit の並列プロセス数（Integration / Feature）。memory_limit がプロセスごとに掛かるので、マシンに合わせて抑える
  export PHPUNIT_PROCESSES="${PHPUNIT_PROCESSES:-4}"
}

harness_prepare() {
  if ! port_up "$DB_HOST" "$DB_PORT"; then
    echo "NG: PostgreSQL に接続できない（${DB_HOST}:${DB_PORT}）。docker compose up -d postgres を" >&2
    return 1
  fi
  # Inertia のページを描画する Feature テストは、Vite の manifest が無いと 500 になる（worktree を作った直後など）
  if [ ! -f public/build/manifest.json ]; then
    echo "==> npm run build（public/build が無いため生成）"
    npm run --silent build || return 1
  fi
}

declare -F port_up >/dev/null || port_up() { (exec 3<>"/dev/tcp/$1/$2") 2>/dev/null; }
