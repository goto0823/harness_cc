# .claude/harness.env — scripts/accept.sh と scripts/check.sh が読む、PJ ごとの設定
#
# app の .claude/harness.env にコピーして、<ここに: …> を埋める。
# bash が `. .claude/harness.env` で読み込む（中身はそのままシェルとして実行される）。
# だから信頼できる人だけが書き換えるファイルにする。秘密情報（パスワード、トークン）は書かない。.env から読む。
#
# project.md の「受け入れテスト」「1 本だけ回す」「app の起動と URL」と、同じ値にそろえる。

# ---- 受け入れテスト（scripts/accept.sh）----
# コピー先（app の中の相対パス）。app の .gitignore に入れ、普段のテストの対象には入れない。
# 変えたら headless-build.json の Read / Edit の deny のパスも変える
ACCEPT_DEST_ROOT="tests/Acceptance"

# docs/accept/<タスク名>/ の中で、テストとしてコピーするファイル（accept.md はいつも除く）
ACCEPT_GLOB="*"            # <ここに: 例 "*Test.php"、"*.test.ts"、"test_*.py">

# コピー先のディレクトリ名。テストランナーが名前空間とディレクトリ名を合わせる決まりを持つなら、それに合わせる
#   as-is  … タスク名のまま（reservation-cancel）
#   studly … 先頭を大文字にしてつなぐ（ReservationCancel）
#   snake  … ハイフンを _ に（reservation_cancel）
ACCEPT_DIR_NAME="as-is"

# コピーしたディレクトリ（$1）のテストだけを回す。終了コードをそのまま返す（落ちたら 0 以外）
accept_run() {
  echo "accept_run が未設定（.claude/harness.env を埋める）: $1" >&2
  return 2
  # <ここに: 例 <テストランナー> "$1">
}

# ---- 検査（scripts/check.sh の --changed）----
# --changed の基準。省略時 origin/main
CHECK_BASE="origin/main"   # <ここに: project.md の「PR の向き先」と同じ。例 origin/main>

# ---- 準備（両方で使う）----
# 環境変数だけを決める。軽いので check.sh は毎回、accept.sh はテストの前に呼ぶ。要らなければ消してよい
harness_env() {
  :  # <ここに: 例 export DB_HOST="${DB_HOST:-127.0.0.1}">
}

# DB を使うテストの前に呼ぶ。DB が起きているか、ビルドの生成物があるか。足りなければメッセージを出して 0 以外を返す。
# 自分で DB を起動しない（人がやる）。要らなければ消してよい
harness_prepare() {
  :  # <ここに: 例 port_up "$DB_HOST" 5432 || { echo "DB に接続できない。<起動コマンド> を" >&2; return 1; }>
}

# check.sh からは port_up（scripts/lib/check-lib.sh）が使える。accept.sh からも使えるように、ここにも置いておく
declare -F port_up >/dev/null || port_up() { (exec 3<>"/dev/tcp/$1/$2") 2>/dev/null; }
